@model IReadOnlyList<PW.Elearning.Application.Courses.CourseDto>
@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

@if (Model.Count == 0)
{
    <p>No courses yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Teacher</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Description</td>
                <td>@course.TeacherName</td>
            </tr>
        }
        </tbody>
    </table>
}
